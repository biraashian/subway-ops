# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
# Anchored to the repo root. Unanchored `build/` matches at ANY depth, which
# silently swallowed `.claude/skills/build/` — the /build skill would have been
# missing from every clone with no error anywhere.
/build/
/dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Environment & secrets
.env
.env.*
!.env.example
secrets.toml

# Gmail OAuth artefacts (Task 6.1 — never commit, base64'd into GH secret)
token.json
token.b64
client_secret*.json

# Recorded API fixtures (real responses, never committed)
tests/fixtures/recorded/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# Burst gate output.
# test_logs/ is regenerable machine output — the chronicle points at it, but
# committing every sweep of every phase would drown the diff.
test_logs/
# .drift/schema-before.json IS committed on purpose: it makes each task's
# schema change visible in the review diff, which is the whole point of a drift
# gate. The transient snapshot and the rotation backups are not.
.drift/schema-now.json
.drift/*.bak
# Burst worktrees for [P] tasks
.claude/worktrees/
